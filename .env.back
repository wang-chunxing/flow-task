# ========================
# 数据库通用配置
# ========================
; DATABASE_DRIVER=mysql+pymysql
; DATABASE_DRIVER=mysql+asyncmy
; DATABASE_CONNECTION="mysql+pymysql://user:password@localhost:3306/flow_task?charset=utf8mb4"
; DATABASE_CONNECTION="mysql+asyncmy://user:password@localhost:3306/flow_task?charset=utf8mb4"

TEMPORAL_HOST="localhost:7233"
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=flow_task
DB_URL="mysql+asyncmy://user:password@localhost:3306/flow_task?charset=utf8mb4"
; CONNECTION=mysql+pymysql://user:password@db:3306/flow_task?charset=utf8mb4


# 高级配置
; DATABASE_ENGINE_ARGS_POOL_SIZE=20
; DATABASE_ENGINE_ARGS_MAX_OVERFLOW=10
; DATABASE_ENGINE_ARGS_POOL_RECYCLE=3600

# TLS 安全配置（生产环境需要）
DATABASE_SSL_ENABLED=false
DATABASE_SSL_CA=/certs/ca.pem
DATABASE_SSL_CERT=/certs/client-cert.pem
DATABASE_SSL_KEY=/certs/client-key.pem


# ========================
# Temporal 服务配置
# ========================

# 基础配置
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=flow-task-queue
TEMPORAL_IDENTITY=flow-worker-1

# TLS 安全配置（生产环境需要）
TEMPORAL_TLS_ENABLED=false
TEMPORAL_SERVER_CERT=
TEMPORAL_CLIENT_KEY=

# 高级配置
TEMPORAL_MAX_RETRY_ATTEMPTS=5
TEMPORAL_INITIAL_RETRY_DELAY=1s
TEMPORAL_RETRY_EXPIRATION=1m


REDIS_HOST=localhost
REDIS_PORT=6379
